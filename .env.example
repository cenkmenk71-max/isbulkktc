# Public local Supabase URL/publishable key and canonical application origin.
# This origin drives canonical/hreflang URLs, social metadata, sitemaps and auth callbacks.
# Change NEXT_PUBLIC_APP_URL to the deployment's HTTPS origin in production/previews.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional social sign-in providers. Add only providers configured in Supabase Auth:
# google, linkedin_oidc, facebook
# Set only after the matching providers and callback URLs are configured in Supabase Auth.
AUTH_OAUTH_PROVIDERS=

# Optional GA4 measurement ID. Analytics scripts load only after consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional public business inbox used only to prepare an enterprise quote email.
# Keep empty until the official İşBul KKTC sales address is approved.
SALES_CONTACT_EMAIL=

# Separate local, preview and production credentials. Do not enable actual
# payment, file processing or third-party integrations using example values.
