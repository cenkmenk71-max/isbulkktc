AUTH_OAUTH_PROVIDERS=
NEXT_PUBLIC_APP_URL=
# Server-side fallback origin used when NEXT_PUBLIC_APP_URL is unset (canonical
# URLs, sitemap, auth callbacks) and the origin the notification edge function
# builds dashboard links from. Must be an HTTPS origin.
APP_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional social profiles rendered in the footer. A channel without a URL is
# dropped rather than linked to a placeholder, so leave any you do not run blank.
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=
NEXT_PUBLIC_SOCIAL_X_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
# Cloudflare Turnstile site key (public). Must belong to the same widget as the
# secret stored in Supabase Auth → Attack Protection (security_captcha_secret).
# A mismatched pair makes every captcha-protected submit answer `captcha_failed`.
# Leave blank to disable the widget; auth forms still work without it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SALES_CONTACT_EMAIL=
# Team inbox that receives feedback copies; falls back to SALES_CONTACT_EMAIL.
FEEDBACK_INBOX_EMAIL=
# Team inbox that receives corporate quote leads; falls back to SALES_CONTACT_EMAIL.
SALES_INBOX_EMAIL=
# Resend credentials for transactional + promotional mail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Service role key: used only by the engagement-digest cron and the signed
# unsubscribe route. Never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer token the scheduler must send to POST /api/email/engagement-digest.
ENGAGEMENT_CRON_SECRET=
# Optional dedicated HMAC key for unsubscribe links; falls back to RESEND_API_KEY.
ENGAGEMENT_UNSUBSCRIBE_SECRET=
# Bearer token the scheduler must send to POST /api/push/dispatch.
PUSH_CRON_SECRET=
# Web Push VAPID key pair. Generate once per deployment with
# `npx web-push generate-vapid-keys --json` and keep the private key server-side.
# The public key is served to the browser; VAPID_SUBJECT is a mailto: or https:
# contact the push services can use to reach the operator. All three are required
# for push to be enabled; leaving them blank shows "notifications unavailable"
# in the app and nothing else breaks.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Comma-separated extra hosts allowed to reach the dev server (e.g. tunnel/preview URLs)
NEXT_ALLOWED_DEV_ORIGINS=

# Search-engine ownership verification. Each value is the `content` attribute of
# the corresponding meta tag; leave blank to omit the tag entirely.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=
