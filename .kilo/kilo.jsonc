{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "supabase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@0.5.5",
        "--access-token",
        "YOUR_SUPABASE_ACCESS_TOKEN"
      ],
      "environment": {
        "SUPABASE_ACCESS_TOKEN": "YOUR_SUPABASE_ACCESS_TOKEN"
      }
    }
  }
}