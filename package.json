{
  "name": "isbulkktc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/identity-company-schemas.test.ts tests/unit/candidate-profile-schema.test.ts tests/unit/jobs-schemas.test.ts tests/unit/source-job-import.test.ts tests/unit/resume-parser.test.ts tests/unit/resume-profile-draft.test.ts tests/unit/company-directory.test.ts tests/unit/company-mark.test.ts tests/unit/company-document-parser.test.ts tests/unit/company-profile-completion.test.ts tests/unit/company-directory-autofill.test.ts tests/unit/blog-news-feed.test.ts tests/unit/i18n-message-catalogs.test.ts tests/unit/route-error.test.tsx tests/unit/supabase-parse-error.test.ts",
    "import:company-directory": "tsx scripts/import-company-directory.ts",
    "import:source-jobs": "tsx scripts/import-source-jobs.ts",
    "import:source-jobs:dry": "tsx scripts/import-source-jobs.ts --dry-run",
    "seed:source-jobs": "tsx scripts/generate-source-job-seed.ts",
    "seed:source-jobs:push": "tsx scripts/generate-source-job-seed.ts --push",
    "check:frontend-source": "node scripts/check-frontend-source.mjs",
    "db:start": "node scripts/supabase-local.mjs start",
    "db:status": "node scripts/supabase-local.mjs status",
    "db:stop": "node scripts/supabase-local.mjs stop",
    "test:db": "node scripts/supabase-local.mjs test db",
    "tools:supabase-wsl": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-supabase-wsl.ps1",
    "tools:git": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-git.ps1",
    "tools:vscode-extensions": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-vscode-extensions.ps1",
    "vscode:open": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-vscode.ps1",
    "test:e2e": "node scripts/run-playwright.mjs test",
    "test:e2e:ui": "node scripts/run-playwright.mjs test --ui",
    "security:audit": "bun audit --prod --audit-level=moderate",
    "optimize:assets": "tsx scripts/optimize-assets.ts",
    "logos:fetch": "node scripts/fetch-company-logos.mjs",
    "shot": "tsx scripts/shot.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@react-three/fiber": "9.8.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.13.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "argparse": "2.0.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/cli": "0.1.22",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.2",
    "pg": "^8.23.1",
    "shadcn": "^4.11.0",
    "supabase": "2.120.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
