{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/push/dispatch",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/send-application-notifications",
      "schedule": "0 9 * * *"
    }
  ]
}
