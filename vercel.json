{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/push/dispatch",
      "schedule": "* * * * *",
      "config": {
        "headers": {
          "Authorization": "Bearer $PUSH_CRON_SECRET"
        }
      }
    },
    {
      "path": "/api/cron/send-application-notifications",
      "schedule": "* * * * *",
      "config": {
        "headers": {
          "Authorization": "Bearer $NOTIFICATION_CRON_SECRET"
        }
      }
    }
  ]
}
